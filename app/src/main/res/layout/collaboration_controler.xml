<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical" >

    <HorizontalScrollView
        android:id="@+id/client_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="10dp"
        android:background="@color/white" >
        <LinearLayout
            android:id="@+id/client_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/ctrl_btn_area"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="10dp"
        android:orientation="horizontal" >
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1" >
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/StartPrint"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1" >
            <TextView
                android:id="@+id/tv_start"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="@dimen/ctrlButtonsTextsize"
                android:textColor="@color/ctrl_btn_print_selector"
                android:background="@drawable/bg_big_button"
                android:text="@string/str_btn_print" />
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/StopPrint"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1" >
            <TextView
                android:id="@+id/tv_stop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="@dimen/ctrlButtonsTextsize"
                android:textColor="@color/ctrl_btn_print_selector"
                android:background="@drawable/bg_big_button"
                android:text="@string/str_btn_stop" />
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1" >
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>